{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiniFy",
  "version": "0.1.0",
  "identifier": "com.modiostudio.minify",
  "build": {
    "beforeDevCommand": "pnpm audio:prepare && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm audio:prepare && node src-tauri/scripts/inject-pubkey.js && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "MiniFy",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "resizable": true,
        "maximized": true,
        "transparent": false,
        "alwaysOnTop": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": false,
        "scope": [
          "https://*.spotify.com/*"
        ]
      }
    }
  },
  "bundle": {
    "resources": [
      "resources/audio/**/*"
    ],
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGMzVDRDRGQ0UyRTdEMTgKUldRWWZTN09UODAxZnpvemRYYXc1TTJycERLR3F5cVZXNHBuZ0lTeGpXdXlhR3Ivbjh0ZXNETCsK",
      "endpoints": [
        "https://github.com/ModioStudio/MiniFy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
